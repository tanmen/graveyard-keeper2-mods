<Project Sdk="Microsoft.NET.Sdk">

  <!--
    タブの帯の詰め方・数の刻み・2 度押し（ゲームに依存しない部分）。テストはこのプロジェクトを参照し、
    mod 本体（../ModsMenu/ModsMenu.csproj）は同じソースを自分の DLL に取り込む（mod を DLL 1 本で配るため）。
    型はどれも internal（Mods Menu の公開の口は ModsMenu.ModsMenuApi と ModPage だけにする）で、テストにだけ見せる。
    ゲームの Mono で動くよう netstandard2.0 / C# 9 に留める。
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>ModsMenu.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ModsMenu.Core.Tests" />
  </ItemGroup>

</Project>
