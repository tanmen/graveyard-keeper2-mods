<Project Sdk="Microsoft.NET.Sdk">

  <!--
    製作メモの一覧・保存形式・進み具合の計算（ゲームに依存しない部分）。テストはこのプロジェクトを参照し、
    mod 本体（../CraftTodo/CraftTodo.csproj）は同じソースを自分の DLL に取り込む（mod を DLL 1 本で配るため）。
    ゲームの Mono で動くよう netstandard2.0 / C# 9 に留める。
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>CraftTodo.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
