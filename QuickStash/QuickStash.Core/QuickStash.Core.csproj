<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ロックの一覧・しまう先の順・知らせの文（ゲームに依存しない部分）。テストはこのプロジェクトを参照し、
    mod 本体（../QuickStash/QuickStash.csproj）は同じソースを自分の DLL に取り込む（mod を DLL 1 本で配るため）。
    ゲームの Mono で動くよう netstandard2.0 / C# 9 に留める。
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>QuickStash.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
